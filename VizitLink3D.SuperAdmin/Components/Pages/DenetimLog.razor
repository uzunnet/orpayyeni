@page "/denetim-log"
@rendermode InteractiveServer

<PageTitle>Denetim Log — SuperAdmin</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Denetim Log</MudText>

<MudCard Elevation="2" Class="pa-6 mt-4">
    <MudCardContent Class="text-center">
        <MudIcon Icon="@Icons.Material.Filled.History"
                 Size="Size.Large"
                 Color="Color.Secondary"
                 Class="mb-4"
                 Style="font-size: 64px;" />
        <MudText Typo="Typo.h5" GutterBottom="true">Denetim Log Sistemi</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary">
            Denetim log sistemi yakında eklenecek.
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
            Bu özellik ile tüm sistem işlemleri, kullanıcı giriş çıkışları ve yapılandırma değişiklikleri takip edilebilecektir.
        </MudText>
    </MudCardContent>
</MudCard>
