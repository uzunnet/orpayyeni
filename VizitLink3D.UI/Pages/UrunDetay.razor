@page "/urun/{Slug}"
@page "/banyo-dolabi/{Slug}"
@layout VizitLink3DDuzen

<PageTitle>@(_urun?.SeoBaslik ?? _urun?.Ad ?? dil.T("urun.detay", "Ürün Detayı"))</PageTitle>

<section class="urun-detay-v2">
    @if (_yukleniyor)
    {
        <div class="urun-detay-v2__durum">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <p class="urun-detay-v2__durum-metin">@dil.T("ortak.yukleniyor", "Yükleniyor...")</p>
        </div>
    }
    else if (_urun is null)
    {
        <div class="urun-detay-v2__durum">
            <h2 class="urun-detay-v2__durum-baslik">@dil.T("urun.bulunamadi", "Model Bulunamadı")</h2>
            <a class="urun-detay-v2__durum-link" href="/banyo-dolaplari">@dil.T("urun.listeyeDon", "Listeye Dön")</a>
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(HataMesaji))
        {
            <div class="urun-detay-v2__container" style="margin-bottom:1.5rem">
                <div class="glass-panel" style="padding:1.5rem;border-left:2px solid var(--tema-hata);border-radius:0.25rem">
                    <p style="color:var(--tema-hata);font-weight:600;margin-bottom:0.5rem">@dil.T("ortak.hata", "Bir hata oluştu.")</p>
                    <p class="urun-detay-v2__hata-metni">@HataMesaji</p>
                </div>
            </div>
        }

        <!-- ════════════════════════════════════════════════
             BÖLÜM 1: HERO — BENTO GRID
             ════════════════════════════════════════════════ -->
        <section class="urun-detay-v2__hero urun-detay-v2__container">
            <!-- Breadcrumbs -->
            <div class="urun-detay-v2__breadcrumb reveal-element">
                <a href="/">@dil.T("menu.anasayfa", "Ana Sayfa")</a>
                <span class="urun-detay-v2__breadcrumb-sep">›</span>
                <a href="/banyo-dolaplari">@dil.T("menu.urunler", "Ürünler")</a>
                <span class="urun-detay-v2__breadcrumb-sep">›</span>
                <span class="active">@_urun.Ad</span>
            </div>

            <div class="urun-detay-v2__hero-grid">
                <!-- Sol: Ana Görsel -->
                <div class="urun-detay-v2__hero-gorsel glow-effect scale-in" @onclick="() => LightboxAc(0)">
                    <img src="@HeroGorselUrl" alt="@_urun.Ad" />
                    @if (KatalogOlculer.Count > 0)
                    {
                        var ilkOlcu = KatalogOlculer[0];
                        <div class="urun-detay-v2__hero-overlay glass-panel">
                            <div>
                                <h3 class="urun-detay-v2__hero-overlay-baslik">@KoleksiyonAdi</h3>
                                <p class="urun-detay-v2__hero-overlay-alt">@AnaOzeti</p>
                            </div>
                            <div class="urun-detay-v2__hero-overlay-veri">
                                @if (!string.IsNullOrWhiteSpace(ilkOlcu.Yukseklik))
                                {
                                    <div class="urun-detay-v2__hero-overlay-veri-oge">
                                        <span class="urun-detay-v2__hero-overlay-etiket">YÜKSEKLİK</span>
                                        <span class="urun-detay-v2__hero-overlay-deger">@ilkOlcu.Yukseklik</span>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(ilkOlcu.Genislik))
                                {
                                    <div class="urun-detay-v2__hero-overlay-veri-oge urun-detay-v2__hero-overlay-veri-oge--cizgili">
                                        <span class="urun-detay-v2__hero-overlay-etiket">GENİŞLİK</span>
                                        <span class="urun-detay-v2__hero-overlay-deger">@ilkOlcu.Genislik</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- Sağ: Ürün Bilgisi -->
                <div class="urun-detay-v2__hero-bilgi reveal-element">
                    <div class="urun-detay-v2__premium-rozet">
                        <span class="urun-detay-v2__premium-rozet-nokta"></span>
                        <span class="urun-detay-v2__premium-rozet-metin">@KategoriAdi</span>
                    </div>

                    <h1 class="urun-detay-v2__baslik">
                        @_urun.Ad
                    </h1>

                    <p class="urun-detay-v2__aciklama">@AnaOzeti</p>

                    <!-- Feature Chip'leri -->
                    @if (KatalogOzellikleri.Count > 0)
                    {
                        <div class="urun-detay-v2__chip-liste">
                            @foreach (var ozellik in KatalogOzellikleri)
                            {
                                <div class="urun-detay-v2__chip glass-panel">
                                    <span class="urun-detay-v2__chip-ikon">
                                        @if (OzellikIkonuBul(ozellik) is { } ikonYolu)
                                        {
                                            <span style="display:block;width:18px;height:18px;background-color:var(--tema-ikincil);mask-image:url('@ikonYolu');-webkit-mask-image:url('@ikonYolu');mask-size:contain;-webkit-mask-size:contain;mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat"></span>
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@Icons.Material.Outlined.CheckCircleOutline" Size="Size.Small" />
                                        }
                                    </span>
                                    <span>@ozellik</span>
                                </div>
                            }
                        </div>
                    }

                    <!-- Aksiyon Butonları -->
                    <div class="urun-detay-v2__eylemler">
                        <a class="urun-detay-v2__btn-birincil" href="/iletisim">
                            <span>@dil.T("teklif.al", "TEKLİF AL")</span>
                            <MudIcon Icon="@Icons.Material.Outlined.ArrowForward" Size="Size.Small" />
                        </a>
                        @if (!string.IsNullOrWhiteSpace(TeknikCizimUrl))
                        {
                            <a class="urun-detay-v2__btn-ikincil" href="@TeknikCizimUrl" target="_blank" rel="noopener">
                                <MudIcon Icon="@Icons.Material.Outlined.Download" Size="Size.Small" />
                                <span>@dil.T("urun.teknikPdf", "TEKNİK PDF")</span>
                            </a>
                        }
                        else
                        {
                            <span class="urun-detay-v2__btn-ikincil urun-detay-v2__btn-ikincil--devre-disi" title="@dil.T("urun.teknikPdfYok", "Teknik doküman bulunmuyor")">
                                <MudIcon Icon="@Icons.Material.Outlined.Download" Size="Size.Small" />
                                <span>@dil.T("urun.teknikPdf", "TEKNİK PDF")</span>
                            </span>
                        }
                    </div>
                </div>
            </div>
        </section>

        <!-- ════════════════════════════════════════════════
             BÖLÜM 2: TEKNİK ÖZELLİKLER
             ════════════════════════════════════════════════ -->
        <section class="urun-detay-v2__teknik urun-detay-v2__container">
            <div class="urun-detay-v2__teknik-grid">
                <!-- Sol: Teknik Özellik Data Satırları -->
                <div class="urun-detay-v2__teknik-bilgi reveal-element">
                    <h2 class="urun-detay-v2__teknik-baslik">
                        @dil.T("urun.ozellikler", "Teknik Özellikler")<br/>
                        <span class="urun-detay-v2__teknik-baslik-italik">&amp; Malzeme Analizi</span>
                    </h2>
                    <div class="urun-detay-v2__teknik-data-satirlari">
                        @if (KatalogOlculer.Count > 0)
                        {
                            var olcuSiniflari = new[] { "", "urun-detay-v2__teknik-data-satir--primary", "urun-detay-v2__teknik-data-satir--soluk" };
                            var olcuIndex = 0;
                            @foreach (var olcu in KatalogOlculer)
                            {
                                var sinif = olcuSiniflari[olcuIndex % olcuSiniflari.Length];
                                <div class="urun-detay-v2__teknik-data-satir glass-panel @sinif">
                                    <div class="urun-detay-v2__teknik-data-ust">
                                        <h4 class="urun-detay-v2__teknik-data-baslik">@olcu.Baslik</h4>
                                        @if (!string.IsNullOrWhiteSpace(olcu.Derinlik))
                                        {
                                            <span class="urun-detay-v2__teknik-data-standart">@olcu.Derinlik</span>
                                        }
                                    </div>
                                    <div class="urun-detay-v2__teknik-data-alt">
                                        <p class="urun-detay-v2__teknik-data-aciklama">
                                            @if (!string.IsNullOrWhiteSpace(olcu.Yukseklik))
                                            {
                                                <span>Y: @olcu.Yukseklik</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(olcu.Genislik))
                                            {
                                                <span> G: @olcu.Genislik</span>
                                            }
                                        </p>
                                        @if (!string.IsNullOrWhiteSpace(olcu.Yukseklik))
                                        {
                                            <span class="urun-detay-v2__teknik-data-deger">@olcu.Yukseklik
                                                <span class="urun-detay-v2__teknik-data-birim">mm</span>
                                            </span>
                                        }
                                    </div>
                                </div>
                                olcuIndex++;
                            }
                        }
                        else
                        {
                            <div class="glass-panel" style="padding:2rem;text-align:center;border-radius:0.25rem">
                                <p style="color:var(--tema-metin-soluk)">@dil.T("urun.olcuBilgisiYok", "Bu ürün için ölçü bilgisi tanımlı değil.")</p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Sağ: Katman Görselleştirme -->
                <div class="urun-detay-v2__teknik-katman glass-panel scale-in">
                    <div class="urun-detay-v2__teknik-katman-ic">
                        <div class="urun-detay-v2__teknik-katman-kat urun-detay-v2__teknik-katman-kat--ust">
                            <span class="urun-detay-v2__teknik-katman-etiket">@dil.T("urun.katmanUst", "Üst Koruma Katmanı")</span>
                        </div>
                        <div class="urun-detay-v2__teknik-katman-kat urun-detay-v2__teknik-katman-kat--orta">
                            <span class="urun-detay-v2__teknik-katman-etiket">@dil.T("urun.katmanDekor", "Dekoratif PVC Film")</span>
                        </div>
                        <div class="urun-detay-v2__teknik-katman-kat urun-detay-v2__teknik-katman-kat--alt">
                            <span class="urun-detay-v2__teknik-katman-etiket">@dil.T("urun.katmanAlt", "HDF / MDF Alt Katman")</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ════════════════════════════════════════════════
             BÖLÜM 2B: TEKNİK ÖLÇÜ TABLOSU (H/W/D)
             ════════════════════════════════════════════════ -->
        @if (KatalogOlculer.Count > 0)
        {
            <section class="urun-detay-v2__olcu-bolumu urun-detay-v2__container reveal-element">
                <h3 class="urun-detay-v2__olcu-baslik">
                    @dil.T("urun.teknikOlculer", "Teknik Ölçüler")
                </h3>
                <div class="glass-panel" style="overflow-x:auto;border-radius:0.25rem">
                    <table class="urun-detay-v2__olcu-tablo">
                        <thead>
                            <tr>
                                <th>@dil.T("urun.olcuBaslik", "Ölçü")</th>
                                <th>@dil.T("urun.olcuH", "Y")</th>
                                <th>@dil.T("urun.olcuW", "G")</th>
                                <th>@dil.T("urun.olcuD", "D")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var olcu in KatalogOlculer)
                            {
                                <tr>
                                    <td>@olcu.Baslik</td>
                                    <td>@olcu.Yukseklik</td>
                                    <td>@olcu.Genislik</td>
                                    <td>@olcu.Derinlik</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (!string.IsNullOrWhiteSpace(TeknikCizimUrl))
                {
                    <a class="urun-detay-v2__olcu-teknik-link" href="@TeknikCizimUrl" target="_blank" rel="noopener">
                        <MudIcon Icon="@Icons.Material.Outlined.ZoomIn" Size="Size.Small" />
                        <span>@dil.T("urun.teknikCizimGor", "Teknik Çizimi Gör")</span>
                    </a>
                }
            </section>
        }

        <!-- ════════════════════════════════════════════════
             BÖLÜM 3: RENK & DOKU KOLEKSİYONU
             ════════════════════════════════════════════════ -->
        <section class="urun-detay-v2__renkler urun-detay-v2__container reveal-element">
            <div class="urun-detay-v2__renkler-ust">
                <div>
                    <h2 class="urun-detay-v2__renkler-baslik">
                        @dil.T("urun.renkler", "Renk &amp; Doku")<br/>
                        <span class="urun-detay-v2__renkler-baslik-alt">@dil.T("urun.renkKoleksiyon", "Koleksiyonu")</span>
                    </h2>
                </div>
                <div class="urun-detay-v2__renkler-nav">
                    <button class="urun-detay-v2__renkler-nav-btn glass-panel" type="button" aria-label="@dil.T("urun.renkOnceki", "Önceki")">
                        <MudIcon Icon="@Icons.Material.Outlined.ArrowBack" Size="Size.Small" />
                    </button>
                    <button class="urun-detay-v2__renkler-nav-btn glass-panel" type="button" aria-label="@dil.T("urun.renkSonraki", "Sonraki")">
                        <MudIcon Icon="@Icons.Material.Outlined.ArrowForward" Size="Size.Small" />
                    </button>
                </div>
            </div>

            @if (RenkSwatchListesi.Count == 0)
            {
                <p class="urun-detay-v2__renk-yok">@dil.T("urun.renkBilgisiYok", "Bu ürün için renk bilgisi tanımlı değil.")</p>
            }
            else
            {
                <div class="urun-detay-v2__renkler-kaydir custom-scrollbar">
                    @foreach (var renk in RenkSwatchListesi)
                    {
                        <div class="urun-detay-v2__renk-kart">
                            <div class="urun-detay-v2__renk-kart-gorsel" style="background-color:@renk.Hex">
                                <div class="urun-detay-v2__renk-kart-overlay">
                                    <span class="urun-detay-v2__renk-kart-zoom-ikon">
                                        <MudIcon Icon="@Icons.Material.Outlined.ZoomIn" Size="Size.Large" />
                                    </span>
                                </div>
                            </div>
                            <div>
                                <h4 class="urun-detay-v2__renk-kart-ad">@renk.Ad</h4>
                                <p class="urun-detay-v2__renk-kart-kod">@renk.Hex</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>

        <!-- ════════════════════════════════════════════════
             BÖLÜM 4: BENZER ÜRÜNLER
             ════════════════════════════════════════════════ -->
        @if (BenzerUrunler.Count != 0)
        {
            <section class="urun-detay-v2__benzer urun-detay-v2__container reveal-element">
                <div class="urun-detay-v2__benzer-icerik">
                    <h2 class="urun-detay-v2__benzer-baslik">
                        @dil.T("urun.benzer", "Benzer")
                        <span class="urun-detay-v2__benzer-baslik-vurgu"> @dil.T("urun.benzerUrunler", "Ürünler")</span>
                    </h2>
                    <div class="urun-detay-v2__benzer-grid">
                        @foreach (var benzer in BenzerUrunler)
                        {
                            <a class="urun-detay-v2__benzer-kart" href="/banyo-dolabi/@benzer.Slug">
                                <div class="urun-detay-v2__benzer-kart-gorsel glass-panel">
                                    <img src="@UrunGorunumYardimcisi.AnaGorselUrl(benzer, Api.ApiBaseUrl)" alt="@benzer.Ad" />
                                    <div class="urun-detay-v2__benzer-kart-gradient"></div>
                                    <div class="urun-detay-v2__benzer-kart-rozet">@benzer.Kod</div>
                                </div>
                                <h3 class="urun-detay-v2__benzer-kart-ad">@benzer.Ad</h3>
                                <p class="urun-detay-v2__benzer-kart-aciklama">@UrunGorunumYardimcisi.OzetMetniBul(benzer)</p>
                            </a>
                        }
                    </div>
                </div>
            </section>
        }

        <!-- ════════════════════════════════════════════════
             BÖLÜM 5: EN ÇOK GEZİLENLER
             ════════════════════════════════════════════════ -->
        @if (EnCokGezilenler.Count != 0)
        {
            <section class="urun-detay-v2__benzer urun-detay-v2__container reveal-element">
                <div class="urun-detay-v2__benzer-icerik">
                    <h2 class="urun-detay-v2__benzer-baslik">
                        @dil.T("urun.populer", "Ziyaretçilerin")
                        <span class="urun-detay-v2__benzer-baslik-vurgu"> @dil.T("urun.enCokGezilen", "İlgisi")</span>
                    </h2>
                    <p style="text-align:center;color:var(--tema-metin-ikincil);margin-bottom:3rem;margin-top:-1.5rem;font-size:1rem">
                        @dil.T("urun.enCokGezilenAciklama", "Sitede en çok ziyaret edilen modeller.")
                    </p>
                    <div class="urun-detay-v2__benzer-grid">
                        @foreach (var populer in EnCokGezilenler)
                        {
                            <a class="urun-detay-v2__benzer-kart" href="/banyo-dolabi/@populer.Slug">
                                <div class="urun-detay-v2__benzer-kart-gorsel glass-panel">
                                    <img src="@UrunGorunumYardimcisi.AnaGorselUrl(populer, Api.ApiBaseUrl)" alt="@populer.Ad" />
                                    <div class="urun-detay-v2__benzer-kart-gradient"></div>
                                    <div class="urun-detay-v2__benzer-kart-rozet">@populer.Kod</div>
                                </div>
                                <h3 class="urun-detay-v2__benzer-kart-ad">@populer.Ad</h3>
                                <p class="urun-detay-v2__benzer-kart-aciklama">@UrunGorunumYardimcisi.OzetMetniBul(populer)</p>
                            </a>
                        }
                    </div>
                </div>
            </section>
        }

        <!-- ════════════════════════════════════════════════
             LIGHTBOX
             ════════════════════════════════════════════════ -->
        @if (_lightboxAcik)
        {
            <div class="urun-detay-v2__lightbox" @onclick="LightboxKapat">
                <button class="urun-detay-v2__lightbox-kapat" @onclick="LightboxKapat" @onclick:stopPropagation="true">
                    <MudIcon Icon="@Icons.Material.Outlined.Close" Size="Size.Medium" />
                </button>
                @if (GaleriGorselleri.Count > 1)
                {
                    <button class="urun-detay-v2__lightbox-nav urun-detay-v2__lightbox-nav--onceki"
                            @onclick="LightboxOnceki" @onclick:stopPropagation="true">
                        <MudIcon Icon="@Icons.Material.Outlined.ChevronLeft" Size="Size.Large" />
                    </button>
                }
                <img class="urun-detay-v2__lightbox-gorsel"
                     src="@GaleriGorselleri[_lightboxIndex]"
                     alt="@_urun.Ad"
                     @onclick:stopPropagation="true" />
                @if (GaleriGorselleri.Count > 1)
                {
                    <button class="urun-detay-v2__lightbox-nav urun-detay-v2__lightbox-nav--sonraki"
                            @onclick="LightboxSonraki" @onclick:stopPropagation="true">
                        <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Large" />
                    </button>
                    <div class="urun-detay-v2__lightbox-sayac">@(_lightboxIndex + 1) / @GaleriGorselleri.Count</div>
                }
            </div>
        }
    }
</section>
