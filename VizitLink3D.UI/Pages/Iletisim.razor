@page "/iletisim"
@layout VizitLink3DDuzen

<PageTitle>@DilServisi.T("menu.iletisim", "İletişim")</PageTitle>

<section class="orpay-urunler-yeni">
    <!-- Hero -->
    <div class="orpay-urunler-yeni__hero">
        <div class="orpay-urunler-yeni__hero-ic">
            <span class="orpay-kicker">İletişim</span>
            <h1 class="orpay-urunler-yeni__baslik">Bize Ulaşın</h1>
            <p class="orpay-urunler-yeni__aciklama">Ürünler, ölçüler, renk seçenekleri ve proje teklifleriniz için uzman ekibimize doğrudan ulaşın.</p>
        </div>
    </div>

    <div style="max-width:var(--tema-icerik-genislik);margin:0 auto;padding:3rem 2rem;display:grid;grid-template-columns:1fr 1fr;gap:3rem">
        <!-- Iletisim Bilgileri -->
        <div style="display:flex;flex-direction:column;gap:1.5rem">
            <div>
                <span class="orpay-kicker">Bize Ulaşın</span>
                <h2 style="font-family:var(--tema-font-baslik);font-size:1.5rem;color:var(--tema-metin);margin:1rem 0 0.5rem">Showroom ve Satış Ekibi</h2>
            </div>

            <div style="display:flex;align-items:center;gap:1rem;padding:1rem;border:1px solid var(--tema-cizgi);border-radius:12px">
                <div style="width:40px;height:40px;border-radius:8px;background:var(--tema-arkaplan-2);display:flex;align-items:center;justify-content:center;color:var(--tema-vurgu)">📞</div>
                <div>
                    <span style="font-size:0.75rem;color:var(--tema-metin-soluk);text-transform:uppercase;letter-spacing:0.1em">Telefon</span>
                    <a href="tel:+903663136171" style="display:block;color:var(--tema-metin);font-weight:500;text-decoration:none">+90 366 313 61 71</a>
                </div>
            </div>

            <div style="display:flex;align-items:center;gap:1rem;padding:1rem;border:1px solid var(--tema-cizgi);border-radius:12px">
                <div style="width:40px;height:40px;border-radius:8px;background:var(--tema-arkaplan-2);display:flex;align-items:center;justify-content:center;color:var(--tema-vurgu)">✉️</div>
                <div>
                    <span style="font-size:0.75rem;color:var(--tema-metin-soluk);text-transform:uppercase;letter-spacing:0.1em">E-posta</span>
                    <a href="mailto:iletisim@orpayormanurunleri.com.tr" style="display:block;color:var(--tema-metin);font-weight:500;text-decoration:none">iletisim@orpayormanurunleri.com.tr</a>
                </div>
            </div>

            <div style="display:flex;align-items:center;gap:1rem;padding:1rem;border:1px solid var(--tema-cizgi);border-radius:12px">
                <div style="width:40px;height:40px;border-radius:8px;background:var(--tema-arkaplan-2);display:flex;align-items:center;justify-content:center;color:var(--tema-vurgu)">📍</div>
                <div>
                    <span style="font-size:0.75rem;color:var(--tema-metin-soluk);text-transform:uppercase;letter-spacing:0.1em">Adres</span>
                    <span style="display:block;color:var(--tema-metin);font-weight:500">Harsat Mah. Rihtim Boyu Cd. No:242 Tosya/Kastamonu</span>
                </div>
            </div>

            <div style="display:flex;align-items:center;gap:1rem;padding:1rem;border:1px solid var(--tema-cizgi);border-radius:12px">
                <div style="width:40px;height:40px;border-radius:8px;background:var(--tema-arkaplan-2);display:flex;align-items:center;justify-content:center;color:var(--tema-vurgu)">🕐</div>
                <div>
                    <span style="font-size:0.75rem;color:var(--tema-metin-soluk);text-transform:uppercase;letter-spacing:0.1em">Çalışma Saatleri</span>
                    <span style="display:block;color:var(--tema-metin);font-weight:500">Pzt-Cmt 09:00-18:00</span>
                </div>
            </div>
        </div>

        <!-- Iletisim Formu -->
        <div style="border:1px solid var(--tema-cizgi);border-radius:12px;padding:2rem;background:#fff">
            <h3 style="font-family:var(--tema-font-baslik);font-size:1.3rem;color:var(--tema-metin);margin-bottom:1.5rem">Mesaj Gönderin</h3>
            <div style="display:flex;flex-direction:column;gap:1rem">
                <input type="text" placeholder="Adınız" style="padding:12px;border:1px solid var(--tema-cizgi);border-radius:8px;font-size:0.9rem;color:var(--tema-metin);background:var(--tema-arkaplan)" />
                <input type="email" placeholder="E-posta" style="padding:12px;border:1px solid var(--tema-cizgi);border-radius:8px;font-size:0.9rem;color:var(--tema-metin);background:var(--tema-arkaplan)" />
                <input type="tel" placeholder="Telefon" style="padding:12px;border:1px solid var(--tema-cizgi);border-radius:8px;font-size:0.9rem;color:var(--tema-metin);background:var(--tema-arkaplan)" />
                <textarea placeholder="Mesajınız" rows="5" style="padding:12px;border:1px solid var(--tema-cizgi);border-radius:8px;font-size:0.9rem;color:var(--tema-metin);background:var(--tema-arkaplan);resize:vertical"></textarea>
                <a href="mailto:iletisim@orpayormanurunleri.com.tr" class="orpay-btn orpay-btn--birincil" style="text-align:center">Gönder</a>
            </div>
        </div>
    </div>

    <!-- Harita -->
    <div style="max-width:var(--tema-icerik-genislik);margin:0 auto;padding:0 2rem 3rem">
        <div style="border:1px solid var(--tema-cizgi);border-radius:12px;overflow:hidden;height:400px;background:var(--tema-arkaplan-2)">
            <iframe
                src="https://www.openstreetmap.org/export/embed.html?bbox=34.015%2C41.005%2C34.035%2C41.015&layer=mapnik&marker=41.010%2C34.025"
                style="width:100%;height:100%;border:0"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title="ORPAY Harita">
            </iframe>
        </div>
        <p style="text-align:center;font-size:0.85rem;color:var(--tema-metin-soluk);margin-top:0.75rem">
            Harsat Mah. Rihtim Boyu Cd. No:242 Tosya/Kastamonu
        </p>
    </div>
</section>
