@page "/urunler"
@layout VizitLink3DDuzen

<PageTitle>@dil.T("menu.urunler", "Ürünler")</PageTitle>

@if (_yukleniyor)
{
    <section class="orpay-page">
        <div class="orpay-panel">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Typo="Typo.h6" Class="mt-4">@dil.T("ortak.yukleniyor", "Yükleniyor...")</MudText>
        </div>
    </section>
}
else
{
    @if (!string.IsNullOrWhiteSpace(HataMesaji))
    {
        <section class="orpay-page">
            <div class="orpay-panel">
                <MudText Typo="Typo.h6">@dil.T("ortak.hata", "Bir hata oluştu.")</MudText>
                <MudText Typo="Typo.body2">@HataMesaji</MudText>
            </div>
        </section>
    }

    <!-- Hero -->
    <section class="orpay-urunler-yeni">
        <div class="orpay-urunler-yeni__hero">
            <div class="orpay-urunler-yeni__hero-ic">
                <span class="orpay-kicker">ORPAY</span>
                <h1 class="orpay-urunler-yeni__baslik">@dil.T("urunler.heroBaslik", "Kapı yüzeylerinde kalite ve estetik.")</h1>
                <p class="orpay-urunler-yeni__aciklama">@dil.T("urunler.heroAciklama", "ORPAY ürün koleksiyonumuzu keşfedin.")</p>
            </div>
        </div>

        <!-- Kategori Filtresi ve Sıralama -->
        <div class="orpay-urunler-yeni__filtre-wrapper orpay-reveal d-flex flex-wrap align-center justify-space-between mb-6" style="gap:1rem; padding:0 2rem;">
            <div class="orpay-urunler-yeni__filtre d-flex flex-wrap gap-2">
                <button class="@KoleksiyonSinifi(null)" @onclick="@(() => KoleksiyonSec(null))">Tümü</button>
                @foreach (var kategori in AktifKategoriler)
                {
                    <button class="@KoleksiyonSinifi(KategoriSlug(kategori))" @onclick="@(() => KoleksiyonSec(KategoriSlug(kategori)))">@kategori.Ad</button>
                }
            </div>
            
            <div style="min-width:200px;">
                <MudSelect T="string" Value="@_siralamaSekli" ValueChanged="SiralamaDegisti" Dense="true" Variant="Variant.Outlined" Label="Sıralama" Style="background:#fff; border-radius:8px;">
                    <MudSelectItem T="string" Value="@("varsayilan")">Varsayılan</MudSelectItem>
                    <MudSelectItem T="string" Value="@("ada_gore_artan")">A-Z'ye Sırala</MudSelectItem>
                    <MudSelectItem T="string" Value="@("ada_gore_azalan")">Z-A'ya Sırala</MudSelectItem>
                </MudSelect>
            </div>
        </div>

        <!-- Urun Grid -->
        <div class="orpay-urunler-yeni__grid">
            @foreach (var urun in SayfalanmisUrunler)
            {
                <a class="orpay-urunler-yeni__kart orpay-reveal" href="/urun/@urun.Slug">
                    <div class="orpay-urunler-yeni__kart-gorsel">
                        <img src="@GorselUrl(urun)" alt="@urun.Ad" />
                    </div>
                    <div class="orpay-urunler-yeni__kart-icerik">
                        <span class="orpay-urunler-yeni__kart-kod">@KategoriAdi(urun)</span>
                        <h3 class="orpay-urunler-yeni__kart-ad">@urun.Ad</h3>
                        <p class="orpay-urunler-yeni__kart-aciklama">@OzetMetni(urun)</p>
                        <span class="orpay-urunler-yeni__kart-aksiyon">İncele →</span>
                    </div>
                </a>
            }
        </div>

        @if (_toplamSayfa > 1)
        {
            <div class="d-flex justify-center mt-8 mb-8 orpay-reveal">
                <MudPagination Color="Color.Primary" Count="@_toplamSayfa" Selected="@_guncelSayfa" SelectedChanged="SayfaDegisti" />
            </div>
        }
    </section>
}

