@using VizitLink3D.Ortak.Modeller.Urunler

<MudDialog Class="gb-dialog-katalog">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.h5" Style="font-family:'Noto Serif',serif; font-weight:700; color:#000;">
                @KatalogBaslik
            </MudText>
            <span style="font-family:'Manrope',sans-serif; font-size:12px; color:#666;">
                @Sayfalar.Count Sayfa Görseli
            </span>
        </MudStack>
    </TitleContent>
    <DialogContent>
        @if (Sayfalar == null || !Sayfalar.Any())
        {
            <MudText Typo="Typo.body1">Sayfalar yüklenemedi.</MudText>
        }
        else
        {
            <MudCarousel Class="mud-width-full" Style="height: 75vh; background: #111;" ShowArrows="true" ShowBullets="true" EnableSwipeGesture="true" AutoCycle="false" TData="object">
                @foreach (var sayfa in Sayfalar.OrderBy(s => s.SayfaNo))
                {
                    <MudCarouselItem>
                        <div class="d-flex flex-column align-center justify-center" style="width:100%; height:100%; padding:20px; position:relative;">
                            <img src="@MedyaUrl(sayfa.MedyaId)" alt="@(KatalogBaslik + " Sayfa " + sayfa.SayfaNo)" style="max-width:100%; max-height:85%; object-fit:contain; box-shadow: 0 10px 30px rgba(0,0,0,0.5);" />
                            <div style="position:absolute; bottom:20px; left:50%; transform:translateX(-50%); background:rgba(0,0,0,0.7); color:#fff; font-family:'Manrope',sans-serif; font-size:12px; padding:6px 16px; border-radius:30px; letter-spacing:0.05em;">
                                Sayfa @sayfa.SayfaNo / @Sayfalar.Count
                            </div>
                        </div>
                    </MudCarouselItem>
                }
            </MudCarousel>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Dark" OnClick="Kapat" Variant="Variant.Filled" Style="border-radius: 0; font-family: 'Manrope', sans-serif;">
            Kapat
        </MudButton>
    </DialogActions>
</MudDialog>
