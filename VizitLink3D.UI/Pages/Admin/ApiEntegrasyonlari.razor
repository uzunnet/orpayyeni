@inject VizitLink3D.UI.Servisler.DilServisi dil
@page "/admin/api-ayarlari"
@layout VizitLink3D.UI.Layout.AdminDuzen
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>@dil.T("admin.api.sayfaBasligi", "API Entegrasyonlari") | VizitLink3D Admin</PageTitle>

<MudText Typo="Typo.h4" Class="mb-6 font-weight-bold">@dil.T("admin.api.baslik", "API Entegrasyonlari")</MudText>

<MudGrid>
    <MudItem xs="12" md="6">
        <MudCard Class="glass-card mb-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">@dil.T("admin.api.analyticsBaslik", "Google Analytics ve Meta")</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudTextField @bind-Value="_gaId" Label="@dil.T("admin.api.googleAnalyticsId", "Google Analytics ID (G-XXXXX)")" Variant="Variant.Outlined" Class="mb-3" />
                <MudTextField @bind-Value="_pixelId" Label="@dil.T("admin.api.metaPixelId", "Meta Pixel ID")" Variant="Variant.Outlined" Class="mb-3" />
                <MudTextField @bind-Value="_gtmId" Label="@dil.T("admin.api.googleTagManagerId", "Google Tag Manager ID")" Variant="Variant.Outlined" />
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="KaydetAnalytics" Disabled="@_kaydediliyor">@dil.T("ortak.kaydet","Kaydet")</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudCard Class="glass-card">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">@dil.T("admin.api.aiSaglayicilari", "Yapay Zeka Saglayicilari")</MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Warning" />
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent>
                <MudTextField @bind-Value="_geminiKey" Label="@dil.T("admin.api.geminiApiAnahtari", "Google Gemini API Anahtari")" Variant="Variant.Outlined" Class="mb-3" InputType="InputType.Password" />
                <MudTextField @bind-Value="_openAiKey" Label="@dil.T("admin.api.openAiApiAnahtari", "OpenAI API Anahtari")" Variant="Variant.Outlined" Class="mb-3" InputType="InputType.Password" />
                
                <MudAlert Severity="Severity.Info" Class="mt-4">@dil.T("admin.api.aiAciklama", "Bu anahtarlar paneldeki otomatik ceviri, SEO ve urun aciklamasi yazma ozellikleri icin kullanilacaktir.")</MudAlert>
            </MudCardContent>
            <MudCardActions class="d-flex justify-space-between">
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="TestAi">@dil.T("admin.api.baglantiyiTestEt", "Baglantiyi Test Et")</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="KaydetAi" Disabled="@_kaydediliyor">@dil.T("ortak.kaydet","Kaydet")</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>

