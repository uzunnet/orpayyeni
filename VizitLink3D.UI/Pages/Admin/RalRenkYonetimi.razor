@inject VizitLink3D.UI.Servisler.DilServisi dil
@page "/admin/ral-renk-yonetimi"
@layout VizitLink3D.UI.Layout.AdminDuzen
@using VizitLink3D.Ortak.Modeller.Renkler
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>@dil.T("admin.ral.sayfaBasligi", "RAL Renk Yonetimi") | VizitLink3D Admin</PageTitle>

<AdminSayfaBasligi Baslik='@dil.T("admin.ral.baslik", "RAL Renk Yonetimi")'
                   Aciklama='@dil.T("admin.ral.aciklama", "3D parca renklendirme ve teklif secimleri icin RAL renk katalogunu yonetin.")'
                   Ikon="@Icons.Material.Filled.Palette">
    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
        @_filtreliListe.Count @dil.T("ortak.kayit", "kayit")
    </MudChip>
</AdminSayfaBasligi>

<AdminAracCubugu AramaYerMetni='@dil.T("admin.ral.ara", "Kod, ad, grup veya yuzey tipi ara...")'
                 AramaMetni="@_arama"
                 AramaMetniDegisti="AramaDegisti"
                 AramaYapildi="AramaUygula">
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="YeniAc">
        @dil.T("admin.ral.yeniRenk", "Yeni renk")
    </MudButton>
</AdminAracCubugu>

@if (_yukleniyor)
{
    <AdminYukleniyorIskeleti SatirSayisi="5" />
}

@if (_formAcik)
{
    <MudCard Class="mb-4" Elevation="2">
        <MudCardContent>
            <MudText Typo="Typo.h6" Class="mb-4">
                @(_duzenlemeModu ? dil.T("admin.ral.duzenle", "RAL renk duzenle") : dil.T("admin.ral.yeniRenk", "Yeni renk"))
            </MudText>
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_form.Kod" Label='@dil.T("admin.ral.kod", "Kod")' Required="true" Placeholder="RAL 9016" Class="mb-3" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_form.Ad" Label='@dil.T("ortak.ad", "Ad")' Required="true" Class="mb-3" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_form.HexKod" Label='@dil.T("admin.ral.hexKod", "Hex kod")' Required="true" Placeholder="#FFFFFF" Class="mb-3" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_form.Grup" Label='@dil.T("admin.ral.grup", "Grup")' Class="mb-3" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="string" @bind-Value="_form.YuzeyTipi" Label='@dil.T("admin.ral.yuzeyTipi", "Yuzey tipi")' Required="true" Class="mb-3">
                        @foreach (var yuzey in YuzeyTipleri)
                        {
                            <MudSelectItem Value="@yuzey.Deger">@dil.T(yuzey.DilAnahtari, yuzey.Varsayilan)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudNumericField @bind-Value="_form.KatalogId" Label='@dil.T("admin.ral.katalogId", "Katalog ID")' Class="mb-3" />
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudNumericField @bind-Value="_form.SiraNo" Label='@dil.T("ortak.siraNo", "Sıra No")' Class="mb-3" />
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudSwitch @bind-Value="_form.AktifMi" Label='@dil.T("ortak.aktif", "Aktif")' Color="Color.Primary" Class="mt-4" />
                </MudItem>
                <MudItem xs="12" md="10">
                    <MudText Typo="Typo.body2" Class="mb-2">@dil.T("admin.ral.renkOnizleme", "Renk onizleme")</MudText>
                    <div class="admin-renk-onizleme-buyuk" style="@RenkStili(_form.HexKod)"></div>
                </MudItem>
            </MudGrid>
            <div class="admin-form-actions">
                <MudButton OnClick="FormIptal" Color="Color.Secondary" Disabled="_kaydediliyor">
                    @dil.T("ortak.iptal", "İptal")
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="Kaydet"
                           Disabled="_kaydediliyor"
                           StartIcon="@Icons.Material.Filled.Save">
                    @(_kaydediliyor ? dil.T("ortak.kaydediliyor", "Kaydediliyor") : dil.T("ortak.kaydet", "Kaydet"))
                </MudButton>
            </div>
        </MudCardContent>
    </MudCard>
}

@if (!_yukleniyor && _filtreliListe.Count == 0)
{
    <AdminBosDurum Icon="@Icons.Material.Filled.Palette"
                   Baslik='@dil.T("admin.ral.bosBaslik", "RAL renk bulunamadi")'
                   Aciklama='@dil.T("admin.ral.bosAciklama", "Yeni RAL renk ekleyerek konfigurator renk seceneklerini hazirlayin.")'>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="YeniAc">
            @dil.T("admin.ral.yeniRenk", "Yeni renk")
        </MudButton>
    </AdminBosDurum>
}
else if (!_yukleniyor)
{
    <MudDataGrid Items="@_filtreliListe" Filterable="true" SortMode="SortMode.Multiple" Dense="true" Striped="true" Hover="true" Class="admin-table-wrap">
        <Columns>
            <PropertyColumn Property="x => x.Kod" Title='@dil.T("admin.ral.kod", "Kod")' />
            <PropertyColumn Property="x => x.Ad" Title='@dil.T("ortak.ad", "Ad")' />
            <TemplateColumn Title='@dil.T("admin.ral.renk", "Renk")'>
                <CellTemplate>
                    <div class="admin-renk-onizleme" style="@RenkStili(context.Item.HexKod)"></div>
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.Grup" Title='@dil.T("admin.ral.grup", "Grup")' />
            <PropertyColumn Property="x => x.YuzeyTipi" Title='@dil.T("admin.ral.yuzeyTipi", "Yuzey tipi")' />
            <TemplateColumn Title='@dil.T("ortak.durum", "Durum")'>
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Color="@(context.Item.AktifMi ? Color.Success : Color.Error)" Variant="Variant.Outlined">
                        @(context.Item.AktifMi ? dil.T("ortak.aktif", "Aktif") : dil.T("ortak.pasif", "Pasif"))
                    </MudChip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title='@dil.T("ortak.islemler", "Islemler")'>
                <CellTemplate>
                    <MudTooltip Text='@dil.T("ortak.duzenle", "Düzenle")'>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => Duzenle(context.Item)" />
                    </MudTooltip>
                    <MudTooltip Text='@dil.T("ortak.yayindanKaldir", "Yayindan kaldir")'>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => SilOnay(context.Item)" />
                    </MudTooltip>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager />
        </PagerContent>
    </MudDataGrid>
}
