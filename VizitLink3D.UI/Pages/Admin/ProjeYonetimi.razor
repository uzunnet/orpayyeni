@page "/admin/proje-yonetimi"
@layout VizitLink3D.UI.Layout.AdminDuzen
@using VizitLink3D.Ortak.Modeller
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject VizitLink3D.UI.Servisler.DilServisi dil

<PageTitle>@($"{dil.T("admin.proje.sayfaBasligi", "Proje Yönetimi")} | VizitLink3D")</PageTitle>

<MudText Typo="Typo.h4" Class="mb-2">@dil.T("admin.proje.baslik", "Proje Yönetimi")</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    Toplam @_filtreliListe.Count kayıt
</MudText>

@if (_yukleniyor)
{
    <MudProgressLinear Indeterminate="true" Class="mb-4" />
}

@* Toolbar *@
<div class="d-flex align-center mb-4 gap-2">
    <MudTextField @bind-Value="_arama"
                  OnKeyUp="AramaYap"
                   Placeholder="@dil.T("admin.proje.aramaYeri", "Proje veya müşteri ara...")"
                  Immediate="true"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Class="flex-grow-1" />
    <MudButton Variant="Variant.Outlined"
               Color="Color.Info"
               StartIcon="@Icons.Material.Filled.GTranslate"
               OnClick="TumuCevir"
               Disabled="@(_tumCeviriCalisiyor || _yukleniyor || _filtreliListe.Count == 0)">
        @(_tumCeviriCalisiyor ? $"{dil.T("admin.ceviri.tumuCeviriliyor", "Tumu cevriliyor...")} {_ceviriIslenen}/{_ceviriToplam}" : dil.T("admin.ceviri.tumuCevir", "Tumu Cevir"))
    </MudButton>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="YeniAc">
        @dil.T("ortak.yeni", "Yeni")
    </MudButton>
</div>

@if (!_yukleniyor && _ceviriAnalizi is not null)
{
    <AdminCeviriOzetRozetleri Ozet="@_ceviriAnalizi.Ozet" />
}

@* Inline Form *@
@if (_formAcik)
{
    <MudCard Class="mb-4">
        <MudCardContent>
            <MudText Typo="Typo.h6" Class="mb-4">
                @(_duzenlemeModu ? dil.T("admin.proje.duzenle", "Proje Düzenle") : dil.T("admin.proje.yeni", "Yeni Proje"))
            </MudText>
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_form.Baslik" Label="@dil.T("ortak.baslik", "Başlık")" Class="mb-3" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_form.KisaAciklama" Label="@dil.T("admin.proje.kisaAciklama", "Kısa Açıklama")" Class="mb-3" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_form.MusteriAdi" Label="@dil.T("admin.proje.musteriAdi", "Müşteri Adı")" Class="mb-3" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_form.MusteriSehir" Label="@dil.T("admin.proje.musteriSehir", "Müşteri Şehir")" Class="mb-3" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_form.KapakResim" Label="@dil.T("ortak.kapakResimUrl", "Kapak Resim URL")" Class="mb-3" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudNumericField @bind-Value="_form.SiraNo" Label="@dil.T("ortak.siraNo", "Sıra No")" Class="mb-3" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSwitch @bind-Value="_form.OneCikanMi" Label="@dil.T("admin.proje.oneCikan", "Öne Çıkan")" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSwitch @bind-Value="_form.AktifMi" Label="@dil.T("ortak.aktif", "Aktif")" />
                </MudItem>
            </MudGrid>
        </MudCardContent>
        <MudCardActions>
            <MudButton OnClick="FormIptal" Disabled="@_kaydediliyor">@dil.T("ortak.iptal", "İptal")</MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="Kaydet"
                       Disabled="@_kaydediliyor">
                @(_kaydediliyor ? dil.T("ortak.kaydediliyor", "Kaydediliyor...") : dil.T("ortak.kaydet", "Kaydet"))
            </MudButton>
        </MudCardActions>
    </MudCard>
}

@* DataGrid *@
<MudDataGrid Items="@_filtreliListe"
             Filterable="true"
             SortMode="SortMode.Multiple"
             Dense="true"
             Striped="true"
             Hover="true">
    <Columns>
        <PropertyColumn Property="x => x.SiraNo" Title="@dil.T("ortak.sira", "Sıra")" Sortable="true" />
        <PropertyColumn Property="x => x.Baslik" Title="@dil.T("ortak.baslik", "Başlık")" Sortable="true" Filterable="true" />
        <PropertyColumn Property="x => x.MusteriAdi" Title="@dil.T("admin.proje.musteri", "Müşteri")" Sortable="true" Filterable="true" />
        <PropertyColumn Property="x => x.MusteriSehir" Title="@dil.T("admin.proje.sehir", "Şehir")" Sortable="true" Filterable="true" />
        <TemplateColumn Title="@dil.T("admin.proje.oneCikan", "Öne Çıkan")">
            <CellTemplate>
                <MudIcon Icon="@(context.Item.OneCikanMi ? Icons.Material.Filled.Star : Icons.Material.Filled.StarBorder)"
                         Color="@(context.Item.OneCikanMi ? Color.Warning : Color.Default)" />
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@dil.T("ortak.aktif", "Aktif")">
            <CellTemplate>
                <MudChip Color="@(context.Item.AktifMi ? Color.Success : Color.Error)"
                         Size="Size.Small">
                    @(context.Item.AktifMi ? dil.T("ortak.aktif", "Aktif") : dil.T("ortak.pasif", "Pasif"))
                </MudChip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@dil.T("admin.ceviri.durum", "Ceviri Durumu")">
            <CellTemplate>
                <AdminCeviriDurumRozeti Durum="@(_ceviriAnalizi?.Durumlar.TryGetValue(context.Item.Id, out var durum) == true ? durum : null)" />
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@dil.T("ortak.islemler", "İşlemler")">
            <CellTemplate>
                <MudTooltip Text='@dil.T("admin.aiCevir", "AI ile Çevir")'>
                    <MudIconButton Icon="@Icons.Material.Filled.Translate"
                                   Size="Size.Small"
                                   Color="Color.Info"
                                   OnClick="() => AICeviriDialogAc(context.Item)" />
                </MudTooltip>
                <MudIconButton Icon="@Icons.Material.Filled.AutoAwesome"
                               Size="Size.Small"
                               Color="Color.Primary"
                               Disabled="@_tumCeviriCalisiyor"
                               OnClick="() => KaydiTumDillerdeCevir(context.Item)" />
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Size="Size.Small"
                               OnClick="() => Duzenle(context.Item)" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Size="Size.Small"
                               Color="Color.Error"
                               OnClick="() => SilOnay(context.Item)" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager />
    </PagerContent>
</MudDataGrid>
