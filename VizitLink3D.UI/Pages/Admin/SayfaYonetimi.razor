@page "/admin/sayfa-yonetimi"
@inject VizitLink3D.UI.Servisler.DilServisi dil
@layout VizitLink3D.UI.Layout.AdminDuzen
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>@dil.T("admin.sayfa.sayfaBasligi", "Sayfa Yönetimi") | VizitLink3D Admin</PageTitle>

<MudText Typo="Typo.h4" Class="mb-6 font-weight-bold">@dil.T("admin.sayfa.baslik", "Sayfa Yönetimi")</MudText>

<MudCard Class="glass-card">
    <MudCardHeader>
        <CardHeaderContent>
            <div class="d-flex justify-space-between">
                <MudText Typo="Typo.h6">@dil.T("admin.sayfa.icerikSayfalari", "Icerik Sayfalari")</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.NoteAdd" OnClick="SayfaEkle">@dil.T("admin.sayfa.yeniEkle", "Yeni Sayfa Ekle")</MudButton>
            </div>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudTable Items="@_sayfalar" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0" T="SayfaYonetimi.SayfaTanim" Loading="@_yukleniyor">
            <HeaderContent>
                <MudTh>Sayfa Adı</MudTh>
                <MudTh>Slug (URL)</MudTh>
                <MudTh>Görüntülenme</MudTh>
                <MudTh>Durum</MudTh>
                <MudTh>Son Güncelleme</MudTh>
                <MudTh>İşlemler</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Sayfa Adı">@context.Baslik</MudTd>
                <MudTd DataLabel="Slug">/@context.Bolum</MudTd>
                <MudTd DataLabel="Görüntülenme">@context.Goruntulenme</MudTd>
                <MudTd DataLabel="Durum">
                    <MudChip T="string" Size="Size.Small" Color="@(context.AktifMi ? Color.Success : Color.Error)">
                        @(context.AktifMi ? "Yayında" : "Taslak")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Son Güncelleme">@context.GuncellemeTarihi.ToString("dd.MM.yyyy")</MudTd>
                <MudTd DataLabel="İşlemler">
                    <MudTooltip Text="İçeriği Düzenle">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" Size="Size.Small" OnClick="@(() => SayfaDuzenle(context))" />
                    </MudTooltip>
                    <MudTooltip Text="Sil">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => SayfaSilAsync(context))" />
                    </MudTooltip>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudCardContent>
</MudCard>
