@page "/admin/hizmet-adimi-yonetimi"
@layout VizitLink3D.UI.Layout.AdminDuzen
@using VizitLink3D.Ortak.Modeller
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject VizitLink3D.UI.Servisler.DilServisi dil

<PageTitle>@($"{dil.T("admin.hizmetAdimi.sayfaBasligi", "Hizmet Adimlari")} | VizitLink3D Admin")</PageTitle>

<AdminSayfaBasligi Baslik="@dil.T("admin.hizmetAdimi.baslik", "Hizmet Adimlari")"
                   Aciklama="@dil.T("admin.hizmetAdimi.aciklama", "Frontend hizmet sureci bolumunde gorunen sirali adimlari yonetin.")"
                   Ikon="@Icons.Material.Filled.Timeline" />

<AdminAracCubugu AramaMetni="@_arama"
                 AramaMetniDegisti="AramaMetniDegisti"
                 AramaYerMetni="@dil.T("ortak.ara", "Ara...")">
    <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.GTranslate" OnClick="TumuCevir" Disabled="@(_tumCeviriCalisiyor || _yukleniyor || _filtreliListe.Count == 0)">
        @(_tumCeviriCalisiyor ? $"{dil.T("admin.ceviri.tumuCeviriliyor", "Tumu cevriliyor...")} {_ceviriIslenen}/{_ceviriToplam}" : dil.T("admin.ceviri.tumuCevir", "Tumu Cevir"))
    </MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="YeniAc">
        @dil.T("admin.hizmetAdimi.yeniAdim", "Yeni Adim")
    </MudButton>
</AdminAracCubugu>

@if (!_yukleniyor && _ceviriAnalizi is not null)
{
    <AdminCeviriOzetRozetleri Ozet="@_ceviriAnalizi.Ozet" />
}

@if (_yukleniyor)
{
    <AdminYukleniyorIskeleti SatirSayisi="5" />
}

@if (_formAcik)
{
    <MudPaper Elevation="0" Class="admin-form-panel pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-4">@(_duzenlemeModu ? dil.T("admin.hizmetAdimi.duzenle", "Adim Duzenle") : dil.T("admin.hizmetAdimi.yeniAdim", "Yeni Adim"))</MudText>
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_form.Baslik" Label="@dil.T("ortak.baslik", "Başlık")" Required="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_form.Ikon" Label="@dil.T("admin.hizmetAdimi.ikon", "Ikon")" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_form.Aciklama" Label="@dil.T("ortak.aciklama", "Açıklama")" Lines="3" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudNumericField @bind-Value="_form.AdimNo" Label="@dil.T("admin.hizmetAdimi.adimNo", "Adim No")" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudNumericField @bind-Value="_form.SiraNo" Label="@dil.T("ortak.siraNo", "Sıra No")" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudSwitch @bind-Value="_form.AktifMi" Label="@dil.T("ortak.aktif", "Aktif")" />
            </MudItem>
        </MudGrid>
        <div class="admin-form-actions">
            <MudButton OnClick="FormIptal" Color="Color.Secondary" Disabled="@_kaydediliyor">@dil.T("ortak.iptal", "İptal")</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="Kaydet" Disabled="@_kaydediliyor">@dil.T("ortak.kaydet", "Kaydet")</MudButton>
        </div>
    </MudPaper>
}

@if (!_yukleniyor && _filtreliListe.Count == 0)
{
    <AdminBosDurum Icon="@Icons.Material.Filled.Timeline"
                   Baslik="@dil.T("admin.hizmetAdimi.bosBaslik", "Hizmet adimi bulunamadi")"
                   Aciklama="@dil.T("admin.hizmetAdimi.bosAciklama", "Yeni adim ekleyerek frontend surec anlatimini dinamik hale getirin.")">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="YeniAc">
            @dil.T("admin.hizmetAdimi.yeniAdim", "Yeni Adim")
        </MudButton>
    </AdminBosDurum>
}
else if (!_yukleniyor)
{
    <MudDataGrid Items="@_filtreliListe" Filterable="true" SortMode="SortMode.Multiple" Dense="true" Striped="true" Hover="true">
        <Columns>
            <PropertyColumn Property="x => x.AdimNo" Title="@dil.T("admin.hizmetAdimi.adim", "Adim")" Sortable="true" />
            <PropertyColumn Property="x => x.Baslik" Title="@dil.T("ortak.baslik", "Başlık")" Sortable="true" />
            <PropertyColumn Property="x => x.Ikon" Title="@dil.T("admin.hizmetAdimi.ikon", "Ikon")" />
            <TemplateColumn Title="@dil.T("ortak.aktif", "Aktif")">
                <CellTemplate>
                    <MudChip Size="Size.Small" Color="@(context.Item.AktifMi ? Color.Success : Color.Error)" Variant="Variant.Outlined">
                        @(context.Item.AktifMi ? dil.T("ortak.aktif", "Aktif") : dil.T("ortak.pasif", "Pasif"))
                    </MudChip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="@dil.T("admin.ceviri.durum", "Ceviri Durumu")">
                <CellTemplate>
                    <AdminCeviriDurumRozeti Durum="@(_ceviriAnalizi?.Durumlar.TryGetValue(context.Item.Id, out var durum) == true ? durum : null)" />
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="@dil.T("ortak.islemler", "Islemler")">
                <CellTemplate>
                    <MudIconButton Icon="@Icons.Material.Filled.Translate" Size="Size.Small" Color="Color.Info" OnClick="() => AICeviriDialogAc(context.Item)" />
                    <MudIconButton Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" Color="Color.Primary" Disabled="@_tumCeviriCalisiyor" OnClick="() => KaydiTumDillerdeCevir(context.Item)" />
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => Duzenle(context.Item)" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => SilOnay(context.Item)" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager />
        </PagerContent>
    </MudDataGrid>
}
