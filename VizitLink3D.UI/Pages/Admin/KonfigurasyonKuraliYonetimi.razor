@inject VizitLink3D.UI.Servisler.DilServisi dil
@page "/admin/konfigurasyon-kurali-yonetimi"
@layout VizitLink3D.UI.Layout.AdminDuzen
@using VizitLink3D.Ortak.Modeller.Urunler
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>@dil.T("admin.konfigurasyonKurali.sayfaBasligi", "Konfigürasyon Kuralı Yönetimi") | VizitLink3D Admin</PageTitle>

<MudText Typo="Typo.h4" Class="mb-2">Konfigürasyon Kuralı Yönetimi</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">Parçalar arası yasaklı / zorunlu / önerilen kombinasyon kurallarını yönetin.</MudText>

@if (_yukleniyor)
{
    <MudProgressLinear Indeterminate="true" Class="mb-4" />
}

<MudGrid Class="mb-4">
    <MudItem xs="12" md="6">
        <MudSelect @bind-Value="_seciliUrunId" Label="Ürün Seçin" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" Required="true">
            @foreach (var urun in _urunListesi)
            {
                <MudSelectItem Value="@urun.Id">@urun.Ad (@urun.Kod)</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
</MudGrid>

@if (_seciliUrunId > 0 && _kurallarYukleniyor)
{
    <MudProgressLinear Indeterminate="true" Class="mb-4" />
}

@if (_seciliUrunId > 0 && !_kurallarYukleniyor)
{
    <MudToolBar Class="mb-4">
        <MudText Typo="Typo.body2" Color="Color.Secondary">@_filtreliListe.Count kural</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="YeniAc">@dil.T("admin.konfigurasyon.yeniKural","Yeni Kural")</MudButton>
    </MudToolBar>

    @if (_formAcik)
    {
        <MudCard Class="mb-4" Elevation="2">
            <MudCardContent>
                <MudText Typo="Typo.h6" Class="mb-4">@(_duzenlemeModu ? "Kural Düzenle" : "Yeni Kural")</MudText>
                <MudGrid>
                    <MudItem xs="12" md="4">
                        <MudSelect @bind-Value="_form.Parca1Id" Label="Parça 1" Required="true" Class="mb-3">
                            @foreach (var p in _parcaListesi)
                            {
                                <MudSelectItem Value="@p.Id">@p.GorunenAd</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudSelect T="int?" @bind-Value="_form.Parca1RenkId" Label="Parça 1 Renk (İsteğe Bağlı)" Clearable="true" Class="mb-3">
                            @foreach (var r in _ralListesi)
                            {
                                <MudSelectItem Value="@(r.Id)">
                                    <MudStack Row="true" AlignItems="AlignItems.Center">
                                        <MudPaper Elevation="0" Width="16" Height="16" Style="@($"background-color:{r.HexKod}; border:1px solid var(--mud-palette-divider); margin-right:6px")" />
                                        <MudText>@r.Kod - @r.Ad</MudText>
                                    </MudStack>
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudSelect T="int?" @bind-Value="_form.Parca1MalzemeId" Label="Parça 1 Malzeme (İsteğe Bağlı)" Clearable="true" Class="mb-3">
                            @foreach (var m in _malzemeListesi)
                            {
                                <MudSelectItem Value="@(m.Id)">@m.Ad</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudSelect @bind-Value="_form.Parca2Id" Label="Parça 2" Required="true" Class="mb-3">
                            @foreach (var p in _parcaListesi)
                            {
                                <MudSelectItem Value="@p.Id">@p.GorunenAd</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudSelect T="int?" @bind-Value="_form.Parca2RenkId" Label="Parça 2 Renk (İsteğe Bağlı)" Clearable="true" Class="mb-3">
                            @foreach (var r in _ralListesi)
                            {
                                <MudSelectItem Value="@(r.Id)">
                                    <MudStack Row="true" AlignItems="AlignItems.Center">
                                        <MudPaper Elevation="0" Width="16" Height="16" Style="@($"background-color:{r.HexKod}; border:1px solid var(--mud-palette-divider); margin-right:6px")" />
                                        <MudText>@r.Kod - @r.Ad</MudText>
                                    </MudStack>
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudSelect T="int?" @bind-Value="_form.Parca2MalzemeId" Label="Parça 2 Malzeme (İsteğe Bağlı)" Clearable="true" Class="mb-3">
                            @foreach (var m in _malzemeListesi)
                            {
                                <MudSelectItem Value="@(m.Id)">@m.Ad</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudSelect @bind-Value="_form.KuralTipi" Label="Kural Tipi" Required="true" Class="mb-3">
                            <MudSelectItem Value="@("Yasak")">Yasak</MudSelectItem>
                            <MudSelectItem Value="@("Zorunlu")">Zorunlu</MudSelectItem>
                            <MudSelectItem Value="@("Onerilen")">Önerilen</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudSwitch @bind-Value="_form.AktifMi" Label="Aktif" Color="Color.Primary" Class="mt-4" />
                    </MudItem>
                </MudGrid>
                <MudToolBar>
                    <MudSpacer />
                    <MudButton OnClick="FormIptal" Color="Color.Secondary" Disabled="_kaydediliyor">@dil.T("ortak.iptal","İptal")</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Kaydet" Disabled="_kaydediliyor">@dil.T("ortak.kaydet","Kaydet")</MudButton>
                </MudToolBar>
            </MudCardContent>
        </MudCard>
    }

    <MudDataGrid Items="@_filtreliListe" Filterable="true" SortMode="SortMode.Multiple" Dense="true" Striped="true" Hover="true">
        <Columns>
            <TemplateColumn Title="Parça 1">
                <CellTemplate>
                    @{
                        var p1 = _parcaListesi.FirstOrDefault(p => p.Id == context.Item.Parca1Id);
                    }
                    <MudText>@(p1?.GorunenAd ?? context.Item.Parca1Id.ToString())</MudText>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Parça 2">
                <CellTemplate>
                    @{
                        var p2 = _parcaListesi.FirstOrDefault(p => p.Id == context.Item.Parca2Id);
                    }
                    <MudText>@(p2?.GorunenAd ?? context.Item.Parca2Id.ToString())</MudText>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Kural Tipi">
                <CellTemplate>
                    <MudChip Size="Size.Small" Color="@KuralTipiRengi(context.Item.KuralTipi)" Variant="Variant.Outlined">
                        @context.Item.KuralTipi
                    </MudChip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Aktif">
                <CellTemplate>
                    <MudChip Size="Size.Small" Color="@(context.Item.AktifMi ? Color.Success : Color.Error)" Variant="Variant.Outlined">
                        @(context.Item.AktifMi ? "Aktif" : "Pasif")
                    </MudChip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="İşlemler">
                <CellTemplate>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => Duzenle(context.Item)" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => SilOnay(context.Item)" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager />
        </PagerContent>
    </MudDataGrid>
}
