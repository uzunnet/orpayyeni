@inject VizitLink3D.UI.Servisler.DilServisi dil
@page "/admin/teklif-yonetimi"
@layout VizitLink3D.UI.Layout.AdminDuzen
@using VizitLink3D.Ortak.Modeller.Urunler
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>@dil.T("admin.teklif.sayfaBasligi", "Teklif Yonetimi") | VizitLink3D Admin</PageTitle>

<MudText Typo="Typo.h4" Class="mb-2">@dil.T("admin.teklif.baslik","Teklif Yönetimi")</MudText>

@if (_yukleniyor)
{
    <MudProgressLinear Indeterminate="true" Class="mb-4" />
}
else
{
    <MudGrid Class="mb-4" Spacing="3">
        <MudItem xs="6" sm="4" md="3" lg="2">
            <MudPaper Elevation="1" Class="pa-4 text-center">
                <MudText Typo="Typo.overline" Color="Color.Warning">@dil.T("admin.teklif.bekleyen","Bekleyen")</MudText>
                <MudText Typo="Typo.h5">@_bekleyenSayisi</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="4" md="3" lg="2">
            <MudPaper Elevation="1" Class="pa-4 text-center">
                <MudText Typo="Typo.overline" Color="Color.Info">@dil.T("admin.teklif.incelenen","İncelenen")</MudText>
                <MudText Typo="Typo.h5">@_incelemedeSayisi</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="4" md="3" lg="2">
            <MudPaper Elevation="1" Class="pa-4 text-center">
                <MudText Typo="Typo.overline" Color="Color.Primary">@dil.T("admin.teklif.teklifHazir","Teklif Hazır")</MudText>
                <MudText Typo="Typo.h5">@_teklifHazirSayisi</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="4" md="3" lg="2">
            <MudPaper Elevation="1" Class="pa-4 text-center">
                <MudText Typo="Typo.overline" Color="Color.Success">@dil.T("admin.teklif.tamamlanan","Tamamlanan")</MudText>
                <MudText Typo="Typo.h5">@_tamamlandiSayisi</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

<MudToolBar Class="mb-4">
    <MudTextField @bind-Value="_arama" Placeholder="Ad / Eposta / Telefon ile ara..." Immediate="true" OnKeyUp="AramaYap" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="flex-grow-1 gb-maxw-400" />
</MudToolBar>

<MudDataGrid Items="@_filtreliListe" Filterable="true" SortMode="SortMode.Multiple" Dense="true" Striped="true" Hover="true">
    <Columns>
        <PropertyColumn Property="x => x.MusteriAdSoyad" Title="Müşteri Ad Soyad" />
        <PropertyColumn Property="x => x.Telefon" Title="Telefon" />
        <PropertyColumn Property="x => x.Eposta" Title="E-posta" />
        <PropertyColumn Property="x => x.UrunId" Title="Ürün ID" />
        <TemplateColumn Title="Durum">
            <CellTemplate>
                <MudChip Size="Size.Small" Style="@($"background-color:{DurumRengi(context.Item.Durum)}; color:#fff")">
                    @DurumMetni(context.Item.Durum)
                </MudChip>
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.OlusturulmaTarihi" Title="Oluşturma" Format="dd.MM.yyyy HH:mm" />
        <TemplateColumn Title="İşlemler">
            <CellTemplate>
                <MudButtonGroup>
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" OnClick="() => DetayAcKapa(context.Item)" />
                    <MudMenu Icon="@Icons.Material.Filled.SwapHoriz" Size="Size.Small" EndIcon="@Icons.Material.Filled.ArrowDropDown">
                        <ChildContent>
                            @foreach (var durum in GecerliDurumlar(context.Item.Durum))
                            {
                                <MudMenuItem OnClick="() => DurumDegistir(context.Item, durum)">@DurumMetni(durum)</MudMenuItem>
                            }
                            @if (context.Item.Durum != "İptal")
                            {
                                <MudDivider />
                                <MudMenuItem OnClick="() => IptalEt(context.Item)" Class="mud-error-text">@dil.T("ortak.iptal","İptal")</MudMenuItem>
                            }
                        </ChildContent>
                    </MudMenu>
                </MudButtonGroup>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <ChildRowContent>
        @if (_seciliTeklif != null && context.Item.Id == _seciliTeklif.Id)
        {
            <MudPaper Elevation="0" Class="pa-4" Style="background: var(--mud-palette-background-gray)">
                <MudGrid>
                    <MudItem xs="12" md="4">
                        <MudText Typo="Typo.subtitle2" Class="mb-1">Müşteri Notu</MudText>
                        <MudText Typo="Typo.body2">@(_seciliTeklif.Not ?? "-")</MudText>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudText Typo="Typo.subtitle2" Class="mb-1">Ekran Görüntüsü</MudText>
                        @{
                            var ekranVal = _seciliTeklif.EkranGoruntusuMedyaId;
                            string? ekranSrc = null;
                            if (!string.IsNullOrEmpty(ekranVal))
                            {
                                if (long.TryParse(ekranVal, out long eid))
                                    ekranSrc = $"/api/medya/dosya/{eid}";
                                else
                                    ekranSrc = ekranVal.StartsWith('/') ? ekranVal : "/" + ekranVal;
                            }
                        }
                        @if (ekranSrc != null)
                        {
                            <img src="@ekranSrc" alt="Ekran Görüntüsü"
                                 style="max-width:100%;max-height:180px;object-fit:contain;border-radius:6px;border:1px solid var(--mud-palette-divider);"
                                 onerror="this.onerror=null;this.src='/medya/vizitlink3d_default.png';" />
                            <MudText Typo="Typo.caption" Color="Color.Success" Class="mt-1">@ekranVal</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2">-</MudText>
                        }
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudText Typo="Typo.subtitle2" Class="mb-1">Müşteri Konfigürasyonu ID</MudText>
                        <MudText Typo="Typo.body2">@(_seciliTeklif.MusteriKonfigurasyonuId?.ToString() ?? "-")</MudText>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudText Typo="Typo.subtitle2" Class="mb-1">Son Güncelleme</MudText>
                        <MudText Typo="Typo.body2">@(_seciliTeklif.GuncellenmeTarihi?.ToString("dd.MM.yyyy HH:mm") ?? "-")</MudText>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        }
    </ChildRowContent>
    <PagerContent>
        <MudDataGridPager />
    </PagerContent>
</MudDataGrid>
