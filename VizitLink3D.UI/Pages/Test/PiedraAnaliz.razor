@page "/test/piedra-analiz"
@layout VizitLink3D.UI.Layout.AdminDuzen

<PageTitle>PIEDRA Model Analizi</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">PIEDRA.glb — Parça Analizi</MudText>

<MudGrid>
    <MudItem xs="12" md="7">
        <div id="piedra-analiz-viewer" style="width:100%; height:500px; border:1px solid #CCC; background:#F0F0F0;">
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AnalizEt" Class="mt-3" Disabled="@_analizYapiliyor">
            @(_analizYapiliyor ? "Analiz ediliyor..." : "🔍 Parçaları Analiz Et")
        </MudButton>
    </MudItem>
    <MudItem xs="12" md="5">
        <MudText Typo="Typo.h6" Class="mb-2">Bulunan Parçalar:</MudText>
        
        @if (_analizYapiliyor)
        {
            <MudProgressLinear Indeterminate="true" Class="mb-4" />
        }
        
        @if (!string.IsNullOrEmpty(_analizSonucu))
        {
            <pre style="font-size:11px; background:#1a1a1a; color:#0f0; padding:12px; max-height:400px; overflow:auto; white-space:pre-wrap;">
@_analizSonucu
            </pre>
        }

        @if (_parcalar.Any())
        {
            <MudTable Items="_parcalar" Hover="true" Dense="true" Elevation="1">
                <HeaderContent>
                    <MudTh>No</MudTh>
                    <MudTh>İsim</MudTh>
                    <MudTh>Tip</MudTh>
                    <MudTh>Detay</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@(context.Sira)</MudTd>
                    <MudTd><strong>@context.Isim</strong></MudTd>
                    <MudTd><MudChip T="string" Text="@context.Tip" Size="Size.Small" Color="@(context.Tip == "Grup" ? Color.Primary : Color.Success)" /></MudTd>
                    <MudTd>@context.Detay</MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudItem>
</MudGrid>
