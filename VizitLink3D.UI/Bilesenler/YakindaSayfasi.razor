@namespace VizitLink3D.UI.Bilesenler

<PageTitle>@SayfaBasligiEtiketi</PageTitle>

<section class="orpay-page orpay-yakinda-sayfa">
    <div class="orpay-panel orpay-yakinda-sayfa__panel">
        <span class="orpay-yakinda-sayfa__ikon">
            <MudIcon Icon="@Ikon" Size="Size.Large" />
        </span>
        <span class="orpay-kicker">@Ustbaslik</span>
        @if (!_dinamikIcerikVar)
        {
            <h1 class="orpay-yakinda-sayfa__baslik">@Baslik</h1>
        }
        <div class="orpay-detail-aciklama">@((MarkupString)Aciklama)</div>
    </div>
</section>
