@using VizitLink3D.Ortak.Modeller.Medya
@inject Servisler.DilServisi dil

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@dil.T("medya.seciciBaslik", "Medya Seç")</MudText>
    </TitleContent>
    <DialogContent>
        <MudTabs Elevation="0" Outlined="true" Class="mb-4" ApplyEffectsToContainer="true">
            <MudTabPanel Text="@dil.T("medya.havuzdanSec", "Havuzdan Seç")">
                <div class="medya-secici-filtreler">
                    <MudTextField @bind-Value="_arama" T="string"
                                  Placeholder="@dil.T("ortak.ara", "Ara...")"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Immediate="true"
                                  OnKeyUp="AramaYapildi"
                                  Style="flex:1;" />

                    <MudSelect T="string" @bind-Value="_filtreTipStr"
                               Label="@dil.T("medya.tipFiltre", "Tür")"
                               Clearable="true"
                               Style="min-width:120px;">
                        <MudSelectItem Value="@("")">@dil.T("medya.tumTipler", "Tümü")</MudSelectItem>
                        <MudSelectItem Value="@("resim")">@dil.T("medya.tip.resim", "Resim")</MudSelectItem>
                        <MudSelectItem Value="@("video")">@dil.T("medya.tip.video", "Video")</MudSelectItem>
                        <MudSelectItem Value="@("pdf")">PDF</MudSelectItem>
                        <MudSelectItem Value="@("glb")">3D</MudSelectItem>
                    </MudSelect>
                </div>

                @if (_yukleniyor)
                {
                    <MudProgressLinear Indeterminate="true" />
                }
                else
                {
                    <div class="medya-secici-grid">
                        <MudGrid Spacing="2">
                            @foreach (var medya in _medyaListesi)
                            {
                                <MudItem xs="4" sm="3" md="2">
                                    <MedyaKart MedyaOgesi="medya"
                                               SeciliMi="@(SeciliIdler.Contains(medya.Id))"
                                               Tiklandi="() => MedyaSec(medya)" />
                                </MudItem>
                            }
                        </MudGrid>

                        @if (!_medyaListesi.Any())
                        {
                            <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary" Class="py-6">
                                @dil.T("medya.bosHavuz", "Henüz medya eklenmemiş.")
                            </MudText>
                        }
                    </div>
                }
            </MudTabPanel>

            <MudTabPanel Text="@dil.T("medya.yeniYukle", "Yeni Yükle")">
                <MedyaYukleyici DosyalarYuklendi="YeniDosyalarYuklendi" />
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Iptal">@dil.T("ortak.iptal", "İptal")</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="SecimiOnayla" Disabled="@(!SeciliIdler.Any())">
            @(SeciliIdler.Count > 0
                ? $"{dil.T("ortak.sec", "Seç")} ({SeciliIdler.Count})"
                : dil.T("ortak.sec", "Seç"))
        </MudButton>
    </DialogActions>
</MudDialog>
