@* CtaBanner — Aurelian Onyx gradient CTA bölümü *@

<section class="cta-bolum">
    <div class="cta-bolum__ust-glow"></div>
    <div class="cta-bolum__alt-cizgi"></div>
    <div class="cta-bolum__icerik">
        <h2 class="cta-bolum__baslik anim-reveal-up">
            @Baslik
        </h2>
        <p class="cta-bolum__aciklama anim-reveal-up stagger-1">
            @Aciklama
        </p>
        <div class="cta-bolum__buton-kutu anim-reveal-up stagger-2">
            <a href="@ButonUrl" class="btn-birincil anim-glow-dans cta-bolum__buton">
                @ButonMetin
            </a>
        </div>
    </div>
</section>
