@* MusteriYorumlariCarousel — Müşteri Yorumları Grid *@

<section class="yorumlar-bolum">
    <div class="section-container">
        <div class="section-baslik-kutu anim-reveal-up">
            <span class="section-etiket">@dil.T("anasayfa.yorumlar.etiket", "Müşteri Deneyimi")</span>
            <h2 class="section-baslik">@dil.T("anasayfa.yorumlar.baslik", "Seçkin Yorumlar")</h2>
            <p class="section-aciklama">@dil.T("anasayfa.yorumlar.aciklama", "Müşterilerimizin deneyimleri.")</p>
        </div>

        <div class="yorumlar-grid">
            @foreach (var yorum in _yorumlar)
            {
                <div class="yorum-kart anim-reveal-up">
                    <div class="yorum-kart__yildizlar">
                        @for (int i = 0; i < yorum.Puan; i++)
                        {
                            <span class="material-symbols-outlined yorum-kart__yildiz">star</span>
                        }
                    </div>
                    <p class="yorum-kart__metin">"@yorum.Yorum"</p>
                    <div class="yorum-kart__musteri">
                        <div class="yorum-kart__avatar">
                            <span class="material-symbols-outlined">person</span>
                        </div>
                        <div>
                            <div class="yorum-kart__musteri-ad">@yorum.MusteriAdi</div>
                            <div class="yorum-kart__musteri-sehir">@yorum.MusteriSehir</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
