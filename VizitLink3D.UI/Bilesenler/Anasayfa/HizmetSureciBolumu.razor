@* HizmetSureciBolumu — Nasıl Çalışıyoruz? 3 adım (Keşfet → Tasarla → Üret) *@

<section class="surec-bolum">
    <div class="section-container">
        <div class="section-baslik-kutu anim-reveal-up">
            <span class="section-etiket">@dil.T("anasayfa.nasil-calisir.etiket", "Süreç")</span>
            <h2 class="section-baslik">@dil.T("anasayfa.nasil-calisir.baslik", "Nasıl Çalışıyoruz?")</h2>
            <p class="section-aciklama">@dil.T("anasayfa.nasil-calisir.aciklama", "Hayalinizdeki banyoya giden 3 adım.")</p>
        </div>

        <div class="surec-grid">
            <!-- Adım 1: Keşfet -->
            <div class="surec-adim anim-reveal-up">
                <div class="surec-adim__ikon">
                    <span class="material-symbols-outlined">search_insights</span>
                </div>
                <div class="surec-adim__numarali-daire">01</div>
                <h3 class="surec-adim__baslik">@dil.T("anasayfa.nasil-calisir.adim1.baslik", "Keşfet")</h3>
                <p class="surec-adim__aciklama">@dil.T("anasayfa.nasil-calisir.adim1.aciklama", "Mekanınızı analiz ediyor, ihtiyaçlarınızı dinliyor ve vizyonunuzu anlıyoruz.")</p>
            </div>

            <!-- Adım 2: Tasarla -->
            <div class="surec-adim anim-reveal-up">
                <div class="surec-adim__ikon">
                    <span class="material-symbols-outlined">draw</span>
                </div>
                <div class="surec-adim__numarali-daire">02</div>
                <h3 class="surec-adim__baslik">@dil.T("anasayfa.nasil-calisir.adim2.baslik", "Tasarla")</h3>
                <p class="surec-adim__aciklama">@dil.T("anasayfa.nasil-calisir.adim2.aciklama", "3D modelleme ile banyonuzu önceden görüyor, malzeme ve renk seçimlerini birlikte yapıyoruz.")</p>
            </div>

            <!-- Adım 3: Üret -->
            <div class="surec-adim anim-reveal-up">
                <div class="surec-adim__ikon">
                    <span class="material-symbols-outlined">precision_manufacturing</span>
                </div>
                <div class="surec-adim__numarali-daire">03</div>
                <h3 class="surec-adim__baslik">@dil.T("anasayfa.nasil-calisir.adim3.baslik", "Üret")</h3>
                <p class="surec-adim__aciklama">@dil.T("anasayfa.nasil-calisir.adim3.aciklama", "CNC teknolojisi ve usta el işçiliğiyle üretip, titizlikle monte ediyoruz.")</p>
            </div>
        </div>
    </div>
</section>
