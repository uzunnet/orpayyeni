<MudPaper Elevation="0" Class="admin-bos-durum pa-6 text-center">
    <MudIcon Icon="@Icon" Size="Size.Large" Color="Color.Default" Class="mb-3" />
    <MudText Typo="Typo.h6" Class="mb-1">@Baslik</MudText>
    @if (!string.IsNullOrEmpty(Aciklama))
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">@Aciklama</MudText>
    }
    @if (ChildContent != null)
    {
        <div class="mt-3">@ChildContent</div>
    }
</MudPaper>
