@* Canlı Destek — Profesyonel sağ alt köşe widget *@

<div class="orpay-canli-destek @(_acikMi ? "acik" : "")">
    @* ─── FAB BUTON (Kapalıyken) ─── *@
    @if (!_acikMi)
    {
        <button class="orpay-cd-fab" @onclick="SohbetGoster" title="@dil.T("canli_destek", "Canlı Destek")">
            <span class="orpay-cd-fab-ikon">💬</span>
            <span class="orpay-cd-fab-etiket">@dil.T("canli_destek", "Canlı Destek")</span>
        </button>
    }
    else
    {
        @* ─── SOHBET PANELİ (Açıkken) ─── *@
        <div class="orpay-cd-panel">
            @* Başlık *@
            <div class="orpay-cd-baslik">
                <div class="orpay-cd-baslik-sol">
                    <div class="orpay-cd-avatar">
                        <span>🎧</span>
                    </div>
                    <div>
                        <div class="orpay-cd-baslik-ad">@dil.T("canli_destek", "Canlı Destek")</div>
                        <div class="orpay-cd-baslik-durum">
                            <span class="orpay-cd-durum-nokta"></span>
                            @dil.T("canli_destek.cevrimici", "Çevrimiçi")
                        </div>
                    </div>
                </div>
                <button class="orpay-cd-kapat-btn" @onclick="SohbetGizle" title="Kapat">✕</button>
            </div>

            @* Mesajlar *@
            <div class="orpay-cd-mesajlar">
                @if (_mesajlar.Count == 0)
                {
                    <div class="orpay-cd-hosgeldiniz">
                        <div class="orpay-cd-hosgeldiniz-ikon">👋</div>
                        <div class="orpay-cd-hosgeldiniz-baslik">@dil.T("canli_destek.hosgeldiniz", "Merhaba!")</div>
                        <div class="orpay-cd-hosgeldiniz-metin">@dil.T("canli_destek.yardim", "Size nasıl yardımcı olabiliriz?")</div>
                    </div>
                }
                else
                {
                    @foreach (var m in _mesajlar)
                    {
                        <div class="orpay-cd-mesaj @(m.KullaniciMi ? "kullanici" : "sistem")">
                            <div class="orpay-cd-mesaj-metin">@m.Metin</div>
                            <div class="orpay-cd-mesaj-saat">@m.Tarih.ToString("HH:mm")</div>
                        </div>
                    }
                }
            </div>

            @* Girdi *@
            <div class="orpay-cd-girdi">
                <input type="text" class="orpay-cd-input" 
                       @bind="_yeniMesaj" @bind:event="oninput"
                       @onkeydown="KlavyeDinle"
                       placeholder="@dil.T("canli_destek.mesaj_yaz", "Mesajınızı yazın...")" />
                <button class="orpay-cd-gonder-btn" @onclick="MesajGonder" 
                        disabled="@string.IsNullOrWhiteSpace(_yeniMesaj)">
                    ➤
                </button>
            </div>
        </div>
    }
</div>
