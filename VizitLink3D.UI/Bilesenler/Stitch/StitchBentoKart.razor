@* StitchBentoKart — Aurelian Onyx bento grid kartı (Buyuk/Orta varyant) *@

<a href="@Href" class="@KartClass">
    <div class="stitch-bento__gorsel-kutu">
        <img src="@GorselUrl" alt="@Baslik" class="stitch-bento__gorsel" loading="lazy" />
    </div>
    <div class="stitch-bento__icerik">
        <span class="stitch-bento__etiket">@Etiket</span>
        <h3 class="stitch-bento__baslik">@Baslik</h3>
        <div class="stitch-bento__aksiyon">
            <span>@KesfetMetin</span>
            <span class="material-symbols-outlined">arrow_forward</span>
        </div>
    </div>
</a>
