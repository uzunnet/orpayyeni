?@* Endüstriyel Onay Dialogu â€” Silme, yayýnlama, iptal iþlemleri için *@

<MudDialog Class="admin-dialog">
    <DialogContent>
        <div class="onay-dialog">
            <div class="onay-ikon @(Tur == "sil" ? "silme" : Tur == "uyari" ? "bilgi" : "basarili")">
                <MudIcon Icon="@(Tur == "sil" ? Icons.Material.Filled.DeleteForever :
                               Tur == "uyari" ? Icons.Material.Filled.Warning :
                               Icons.Material.Filled.CheckCircle)"
                         Size="Size.Large" />
            </div>
            <MudText Typo="Typo.h6" Class="mb-2 gb-font-700">@Baslik</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@Mesaj</MudText>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Iptal" Color="Color.Default">
            @dil.T("ortak.iptal", "Ýptal")
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="@(Tur == "sil" ? Color.Error : Tur == "uyari" ? Color.Warning : Color.Primary)"
                   OnClick="Onayla">
            @dil.T("ortak.onayla", "Onayla")
        </MudButton>
    </DialogActions>
</MudDialog>
