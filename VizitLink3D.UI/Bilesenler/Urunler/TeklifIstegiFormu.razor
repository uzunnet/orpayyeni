@using VizitLink3D.Ortak.Modeller.Urunler
@inject VizitLink3D.UI.Servisler.DilServisi dil

@if (_gonderildi)
{
    <MudAlert Severity="Severity.Success" Variant="Variant.Filled" Class="my-4">
        @dil.T("teklif.talepAlindi", "Teklif talebiniz basariyla alindi. En kisa surede size donus yapacagiz.")
    </MudAlert>
}
else
{
    <MudCard Elevation="2" Class="my-4">
        <MudCardContent>
            <MudText Typo="Typo.h6" Class="mb-4">@dil.T("teklif.talepFormu", "Teklif Talep Formu")</MudText>

            @if (!string.IsNullOrEmpty(_hataMesaji))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-3">@_hataMesaji</MudAlert>
            }

            <EditForm Model="@_form" OnValidSubmit="Gonder">
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_form.MusteriAdSoyad" Label="@dil.T("ortak.adSoyad", "Ad Soyad")" Required="true" RequiredError="@dil.T("teklif.adSoyadZorunlu", "Ad soyad zorunludur")" Variant="Variant.Outlined" Class="mb-3" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField @bind-Value="_form.Telefon" Label="@dil.T("ortak.telefon", "Telefon")" Required="true" RequiredError="@dil.T("teklif.telefonZorunlu", "Telefon zorunludur")" Mask="@(new RegexMask(@"^\+?[0-9\s\-\(\)]{7,20}$"))" Variant="Variant.Outlined" Class="mb-3" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField @bind-Value="_form.Eposta" Label="@dil.T("ortak.eposta", "E-posta")" Required="true" RequiredError="@dil.T("teklif.epostaZorunlu", "E-posta zorunludur")" Variant="Variant.Outlined" Class="mb-3" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_form.Not" Label="@dil.T("teklif.notunuz", "Notunuz")" Lines="4" Variant="Variant.Outlined" Class="mb-3" Placeholder="@dil.T("teklif.notYerTutucu", "Eklemek istediginiz notlar...")" />
                    </MudItem>
                </MudGrid>

                @if (_secimOzetleri.Any())
                {
                    <MudText Typo="Typo.subtitle2" Class="mb-2">@dil.T("teklif.secimOzeti", "Secim Ozetiniz")</MudText>
                    <MudPaper Elevation="0" Class="pa-3 mb-4 teklif-secim-ozeti">
                        @foreach (var ozet in _secimOzetleri)
                        {
                            <MudText Typo="Typo.body2">@ozet</MudText>
                        }
                    </MudPaper>
                }

                <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit" Disabled="_gonderiliyor">
                    @(_gonderiliyor ? dil.T("ortak.gonderiliyor", "Gonderiliyor...") : dil.T("teklif.talebiGonder", "Teklif Talebi Gonder"))
                </MudButton>
            </EditForm>
        </MudCardContent>
    </MudCard>
}
