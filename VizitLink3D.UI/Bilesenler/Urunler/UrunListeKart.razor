@using VizitLink3D.Ortak.Modeller.Urunler

<div class="orpay-urun-kart @_temaClass cursor-pointer" @onclick="@Tiklandi">
    <MudCard Elevation="2">
        <div class="orpay-urun-kart-gorsel-sarici">
            <img src="@_gorselUrl" alt="@Urun.Ad"
                 onerror="this.onerror=null;this.src='/medya/vizitlink3d_default.png';" />
        </div>


        <div class="orpay-urun-kart-rozetler">
            @if (!string.IsNullOrWhiteSpace(_koleksiyonGrubu))
            {
                <span class="orpay-rozet orpay-rozet-koleksiyon">@_koleksiyonGrubu</span>
            }
            @if (Urun.VarsayilanUcBoyutModeliId != null)
            {
                <span class="orpay-rozet orpay-rozet-3d">3D</span>
            }
            @if (Urun.YeniMi)
            {
                <span class="orpay-rozet orpay-rozet-yeni">@dil.T("urun.yeni", "Yeni")</span>
            }
        </div>

        <MudCardContent>
            <MudText Typo="Typo.h6" Class="mb-2">
                @Urun.Ad
            </MudText>
            @if (!string.IsNullOrEmpty(Urun.KisaAciklama))
            {
                <MudText Typo="Typo.body2" Color="Color.Dark" Class="orpay-urun-kart-aciklama">
                    @Urun.KisaAciklama
                </MudText>
            }
        </MudCardContent>

        <MudCardActions Class="pa-4 pt-0">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Visibility"
                       OnClick="@HakkindaIste" FullWidth="true">
                @dil.T("urun.incele", "İncele")
            </MudButton>
        </MudCardActions>
    </MudCard>
</div>
