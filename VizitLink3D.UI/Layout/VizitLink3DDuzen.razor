@inherits LayoutComponentBase

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;800&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
</HeadContent>

<MudThemeProvider Theme="@_tema" IsDarkMode="@KoyuTemaMi" />
<MudSnackbarProvider />
<MudDialogProvider />
<MudPopoverProvider />

<div class="orpay-shell" data-tema-id="@_aktifTema">
    <header class="orpay-header">
        <a href="/" class="orpay-brand">
            @if (!string.IsNullOrWhiteSpace(_logoUrl))
            {
                <img src="@_logoUrl" alt="@_firmaAdi" style="max-height:72px;width:auto;" />
            }
            else
            {
                <span class="orpay-brand__mark">@(_firmaAdi.Length > 0 ? _firmaAdi[..1] : "O")</span>
                <span class="orpay-brand__text">@_firmaAdi</span>
            }
        </a>

        <button type="button"
                class="@MobilMenuDugmeClass"
                aria-label="@DilServisi.T("menu.mobilAcKapat", "Menüyü aç veya kapat")"
                aria-expanded="@_mobilMenuAcik"
                aria-controls="orpay-mobil-menu"
                @onclick="MobilMenuDegistir">
            <span class="orpay-mobil-menu-dugme__ikon" aria-hidden="true">
                <span></span><span></span><span></span>
            </span>
            <span class="orpay-mobil-menu-dugme__metin">@DilServisi.T("menu.mobilKisa", "Menü")</span>
        </button>

        <nav class="orpay-nav">
            @foreach (var oge in _menu)
            {
                if (oge.AltMenuler.Count == 0)
                {
                    <a href="@oge.Url" class="orpay-nav__link">@MenuBasligi(oge)</a>
                }
                else
                {
                    <div class="orpay-nav__group">
                        <a href="@oge.Url" class="orpay-nav__link">@MenuBasligi(oge)</a>
                        <div class="orpay-nav__dropdown">
                            @foreach (var alt in oge.AltMenuler)
                            {
                                <a href="@alt.Url" class="orpay-nav__dropdown-link">@MenuBasligi(alt)</a>
                            }
                        </div>
                    </div>
                }
            }
        </nav>

        <nav id="orpay-mobil-menu"
             class="@MobilMenuClass"
             aria-label="@DilServisi.T("menu.mobil", "Mobil menü")">
            <div class="orpay-mobil-menu__araclar">
                <label class="orpay-dil-secici orpay-dil-secici--mobil">
                    <span>@DilServisi.T("ortak.dil", "Dil")</span>
                    <select value="@_aktifDil" @onchange="DilSecildi">
                        @foreach (var dilBilgisi in _diller)
                        {
                            <option value="@dilBilgisi.Kod">@dilBilgisi.Kod.ToUpper()</option>
                        }
                    </select>
                </label>

                <div class="orpay-mod-secici orpay-mod-secici--mobil">
                    <button type="button" class="@TemaModuClass("acik")" @onclick='() => TemaModuDegistir("acik")' title="Açık Tema">
                        <span class="material-symbols-outlined" style="font-size:20px;">light_mode</span>
                    </button>
                    <button type="button" class="@TemaModuClass("koyu")" @onclick='() => TemaModuDegistir("koyu")' title="Koyu Tema">
                        <span class="material-symbols-outlined" style="font-size:20px;">dark_mode</span>
                    </button>
                </div>
            </div>
            @foreach (var oge in _menu)
            {
                <a href="@oge.Url" class="orpay-mobil-menu__link" @onclick="MobilMenuKapat">@MenuBasligi(oge)</a>
                @if (oge.AltMenuler.Count > 0)
                {
                    <div class="orpay-mobil-menu__alt">
                        @foreach (var alt in oge.AltMenuler)
                        {
                            <a href="@alt.Url" class="orpay-mobil-menu__alt-link" @onclick="MobilMenuKapat">@MenuBasligi(alt)</a>
                        }
                    </div>
                }
            }
        </nav>

        <div class="orpay-header__actions">
            <label class="orpay-dil-secici">
                <span>@DilServisi.T("ortak.dil", "Dil")</span>
                <select value="@_aktifDil" @onchange="DilSecildi">
                    @foreach (var dilBilgisi in _diller)
                    {
                        <option value="@dilBilgisi.Kod">@dilBilgisi.Kod.ToUpper()</option>
                    }
                </select>
            </label>

            <div class="orpay-mod-secici">
                <button type="button" class="@TemaModuClass("acik")" @onclick='() => TemaModuDegistir("acik")' title="Açık Tema">
                    <span class="material-symbols-outlined" style="font-size:20px;">light_mode</span>
                </button>
                <button type="button" class="@TemaModuClass("koyu")" @onclick='() => TemaModuDegistir("koyu")' title="Koyu Tema">
                    <span class="material-symbols-outlined" style="font-size:20px;">dark_mode</span>
                </button>
            </div>

            <a class="orpay-cta" href="/iletisim">@DilServisi.T("site.teklifAl", "Teklif Al")</a>
        </div>
    </header>

    <main class="orpay-main orpay-page-transition">
        @Body
    </main>

    <footer class="orpay-footer">
        <div class="orpay-footer__ust">
            <span class="orpay-footer__marka">
                <img src="/logo.png" alt="ORPAY" style="height:40px;width:auto;object-fit:contain;vertical-align:middle;margin-right:0.5rem;" />
                ORPAY
            </span>
        </div>
        <div class="orpay-footer__links">
            <a href="/urunler">@DilServisi.T("site.koleksiyonlar", "Koleksiyonlar")</a>
            <a href="/katalog">@DilServisi.T("site.katalog", "Katalog")</a>
            <a href="/hakkimizda">@DilServisi.T("site.kurumsal", "Kurumsal")</a>
            <a href="/fabrikamiz">@DilServisi.T("site.fabrikamiz", "Fabrikamız")</a>
            <a href="/iletisim">@DilServisi.T("site.iletisim", "İletişim")</a>
        </div>
        <div class="orpay-footer__links" style="padding-top:0;border-top:none;margin-bottom:0;">
            <a href="/kvkk">@DilServisi.T("site.kvkk", "KVKK")</a>
        </div>
        <div class="orpay-footer__alt">
            &copy; 2024 @_firmaAdi. @DilServisi.T("site.tumHaklariSaklidir", "Tüm hakları saklıdır.")
        </div>
    </footer>
</div>
