# Orpay Orman Ürünleri — Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayıp değerleri kendinize göre doldurun.
# .env dosyası ASLA git'e commit edilmez (.gitignore'da var).

# JWT Güvenlik Anahtarı (min 32 karakter)
VIZITLINK3D_JWT_KEY=guvenli_rastgele_en_az_32_karakter_deger

# Lisans HMAC Gizli Anahtarı (min 32 karakter)
VIZITLINK3D_LISANS_KEY=guvenli_rastgele_en_az_32_karakter_deger

# OpenAI API Key (isteğe bağlı — AI özelliği için)
VIZITLINK3D_OPENAI_KEY=

# Anthropic API Key (isteğe bağlı)
VIZITLINK3D_ANTHROPIC_KEY=

# Google Gemini API Key (isteğe bağlı)
VIZITLINK3D_GEMINI_KEY=

# SMTP (E-posta gönderimi için)
VIZITLINK3D_SMTP_HOST=smtp.example.com
VIZITLINK3D_SMTP_PORT=587
VIZITLINK3D_SMTP_USER=user@example.com
VIZITLINK3D_SMTP_PASS=
